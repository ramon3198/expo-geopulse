# Copy to dashboard/.env.local (gitignored) and point it at your backend.
VITE_API_BASE=http://127.0.0.1:8787

# Optional — WebSocket URL (defaults to API base with the ws:// scheme + /ws).
# VITE_WS_URL=ws://127.0.0.1:8787/ws

# Optional — extra hostnames the dev server is served behind (comma-separated),
# e.g. when exposing it through a reverse proxy or tunnel.
# VITE_ALLOWED_HOSTS=app.example.com,.example.com

# Optional — Mapbox token to enable the Mapbox map styles (CARTO is the default).
# VITE_MAPBOX_TOKEN=
