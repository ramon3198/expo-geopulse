root = true

[*.{kt,kts}]
indent_size = 2
indent_style = space
max_line_length = off
insert_final_newline = true

# ktlint adopts the standard ruleset (idiomatic signatures, indentation, imports,
# wrapping, unused code) EXCEPT a few opinions that would degrade this codebase's
# deliberate, documented style:
#   - filename / *-naming: this module intentionally groups types and uses Expo's
#     naming, which ktlint's strict file/identifier rules flag as false positives.
#   - spacing-between-declarations-with-{annotations,comments}: the @Field config
#     block is intentionally grouped with section comments; ktlint would insert a
#     blank line between every field, doubling its length for no benefit.
#   - no-multi-spaces: trailing field comments are column-aligned on purpose
#     (e.g. "@Field var harshAccel = 3.0   // m/s^2") for readability.
ktlint_standard_filename = disabled
ktlint_standard_function-naming = disabled
ktlint_standard_property-naming = disabled
ktlint_standard_spacing-between-declarations-with-annotations = disabled
ktlint_standard_spacing-between-declarations-with-comments = disabled
ktlint_standard_no-multi-spaces = disabled
